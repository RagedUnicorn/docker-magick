{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automatically merge ImageMagick apk updates: superseded pins vanish from the Alpine package index and break the image build, so merge as soon as tests pass",
      "matchDatasources": [
        "repology"
      ],
      "matchPackageNames": [
        "/^alpine_\\d+_\\d+/imagemagick$/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group the pinned ImageMagick apk version into one PR (a single ARG drives the main package and all delegate subpackages)",
      "matchDatasources": [
        "repology"
      ],
      "matchPackageNames": [
        "/^alpine_\\d+_\\d+/imagemagick$/"
      ],
      "groupName": "imagemagick",
      "groupSlug": "imagemagick"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the ImageMagick version in the command test in sync with the pinned apk version (major.minor.patch only, as printed by magick -version)",
      "managerFilePatterns": [
        "/^test/magick_command_test\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- 'ImageMagick (?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "versioningTemplate": "{{{versioning}}}",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)"
    }
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "assignees": [
    "ragedunicorn"
  ]
}
